// Zellij config — matches the Omarchy tokyo-night system theme.
// Built-in tokyo-night theme: full palette, so plugins (tabs, status) render rich.
theme "tokyo-night"

// Main tab bar on top (tabs look), status bar at the bottom (tmux-like).
plugins {
    tab-bar location="zellij:tab-bar" {
        position "top"
    }
    status-bar location="zellij:status-bar" {
        position "bottom"
    }
}

// General settings
scroll_buffer_size 50000
mouse_mode true
pane_frames true